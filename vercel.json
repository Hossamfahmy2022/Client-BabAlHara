{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/client-app/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://new-bab-al-hara.runasp.net/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://new-bab-al-hara.runasp.net/images/:path*"
    },
    {
      "source": "/health",
      "destination": "https://new-bab-al-hara.runasp.net/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
